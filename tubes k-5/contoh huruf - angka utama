#include <stdio.h>
#include <ctype.h>
#include <string.h>

void konversiHurufKeAngka(char teks[]) {
    int hasil[200];
    int i, j = 0;

    printf("\n=== Hasil Konversi Huruf ke Angka ===\n");

    for (i = 0; teks[i] != '\0'; i++) {
        if (isalpha(teks[i])) { 
            hasil[j] = toupper(teks[i]) - 'A' + 1;
            printf("%d ", hasil[j]);
            j++;
        }
    }

    if (j == 0) {
        printf("Tidak ada huruf yang valid.");
    }

    printf("\n");
